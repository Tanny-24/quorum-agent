# Place real values only in .env, which is ignored by Git.
APP_ENV=development
QUORUM_SESSION_DIR=_runtime/sessions
QUORUM_ATTENTION_BUDGET=2
QUORUM_STORE=memory
# Active submission provider. Keep the real key only in ignored .env files.
GEMINI_API_KEY=
QUORUM_MODEL_PROVIDER=gemini
QUORUM_MODEL_ID=gemini-3.6-flash
# Optional future provider settings; unused when QUORUM_MODEL_PROVIDER=gemini.
AWS_REGION=us-west-2
BEDROCK_REASONER_MODEL=
BEDROCK_CLASSIFIER_MODEL=
TELEGRAM_BOT_TOKEN=replace-with-local-secret
TELEGRAM_CHAT_ID=replace-with-local-chat-id
