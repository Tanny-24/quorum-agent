# Place real values only in .env, which is ignored by Git.
APP_ENV=development
QUORUM_SESSION_DIR=_runtime/sessions
QUORUM_ATTENTION_BUDGET=2
QUORUM_STORE=memory
# Primary agent provider. AWS credentials come from the standard credential chain;
# never put AWS access keys, secret keys, or session tokens in this file.
QUORUM_MODEL_PROVIDER=bedrock
QUORUM_MODEL_ID=us.amazon.nova-micro-v1:0
AWS_REGION=us-east-1
# Optional when using a named profile instead of the default AWS profile.
# AWS_PROFILE=quorum-bedrock
# Optional per-purpose overrides; QUORUM_MODEL_ID is used when these are blank.
BEDROCK_REASONER_MODEL=
BEDROCK_CLASSIFIER_MODEL=

# Verified alternate provider. Uncomment these provider/model lines to switch.
# QUORUM_MODEL_PROVIDER=gemini
# QUORUM_MODEL_ID=gemini-3.6-flash
GEMINI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
